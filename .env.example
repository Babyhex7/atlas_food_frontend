# ============================================
# KONFIGURASI FRONTEND ATLAS FOOD (PRODUKSI / VPS / LOCAL)
# ============================================

# REST API Base URL
# Contoh Lokal: http://localhost:8080/api/v1
# Contoh VPS/Domain: https://api.domainanda.com/api/v1 atau http://123.45.67.89:8080/api/v1
API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# WebSocket Base URL (untuk Live Canvas & Kolaborasi Real-time)
# Contoh Lokal: ws://localhost:8080/api/v1
# Contoh VPS/Domain SSL: wss://api.domainanda.com/api/v1 atau ws://123.45.67.89:8080/api/v1
WS_URL=ws://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1

# Storage Base URL (Opsional)
# Kosongkan jika asset disajikan langsung via API backend (/uploads)
# Isi jika menggunakan MinIO / AWS S3 / CDN publik
NEXT_PUBLIC_STORAGE_BASE_URL=
